      [
        "ID",
        "Requirement"
      ],
      [
        "FR1",
        "Register a pan with identity, name, location and area."
      ],
      [
        "FR2",
        "Record timestamped observations of brine salinity, water depth, brine temperature and related fields, with a source label and observer."
      ],
      [
        "FR3",
        "Record weather forecasts and weather observations with issue time and source."
      ],
      [
        "FR4",
        "Assemble a pan-specific digital twin that resolves every displayed value to a recorded source and states its freshness."
      ],
      [
        "FR5",
        "Compute a deterministic rainfall-only response for a stated pan state and rainfall amount."
      ],
      [
        "FR6",
        "Evaluate versioned, operator-configured rules against explicit inputs and record the compared variable, threshold, version and outcome."
      ],
      [
        "FR7",
        "Withhold machine-learning output unless a genuine labelled dataset and a validated deployed model exist, and report that state."
      ],
      [
        "FR8",
        "Record operator decisions (accepted, modified or rejected) separately from recommendations and from physical action records."
      ],
      [
        "FR9",
        "Record field events with milestones, pre- and post-event measurement provenance, interventions, reported versus simulated results and verification state."
      ],
      [
        "FR10",
        "Support controlled correction of recorded values while retaining superseded values and their claimed origins as append-only history."
      ],
      [
        "FR11",
        "Export records with UTC and IST representations and material caveats."
      ]
    ]
  },
