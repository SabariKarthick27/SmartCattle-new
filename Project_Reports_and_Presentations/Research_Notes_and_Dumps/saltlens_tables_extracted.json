      [
        "NFR1",
        "Every figure displayed must state what produced it.",
        "Prevents a computed value being read as a measured one."
      ],
      [
        "NFR2",
        "A simulated state must never silently replace a measured observation.",
        "Protects the integrity of the observed record."
      ],
      [
        "NFR3",
        "Corrections must be append-only; superseded values remain retrievable.",
        "Preserves the audit trail."
      ],
      [
        "NFR4",
        "Timestamps are stored in UTC and shown with site-local (IST) representation.",
        "Avoids ambiguity across systems and exports."
      ],
      [
        "NFR5",
        "Deterministic calculations must be reproducible from recorded inputs and versions.",
        "Enables hand verification and re-running."
      ],
      [
        "NFR6",
        "Demonstration values must be flagged and excluded from research datasets.",
        "Prevents seed or demo data contaminating evidence."
      ],
      [
        "NFR7",
        "Operations must be authorised and integrity-checked.",
        "Protects records and decisions."
      ],
      [
        "NFR8",
        "The interface must remain usable on ordinary browsers.",
        "Operator access from office or field."
