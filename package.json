{
  "name": "smartcattle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "node --max-http-header-size=65536 ./node_modules/next/dist/bin/next dev",
    "dev:python": "uvicorn ml_service.main:app --reload --port 8000",
    "dev": "concurrently -n \"NEXT,PYTHON\" -c \"blue,green\" \"npm run dev:next\" \"npm run dev:python\"",
    "build": "next build",
    "start": "node --max-http-header-size=65536 ./node_modules/next/dist/bin/next start",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:seed": "node scripts/seed.js",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "experiment": "ts-node -r tsconfig-paths/register scripts/experiment.ts",
    "verify:math": "python scripts/verify_chdi_math.py"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "ml-random-forest": "^2.1.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
